# Kalshi API Credentials
KALSHI_API_KEY=your_api_key_here
KALSHI_API_SECRET=your_api_secret_here
KALSHI_API_ENV=demo  # demo or prod

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Portfolio Settings
PORTFOLIO_BALANCE=10000.00   # Starting paper-trade balance in USD

# Risk Parameters (overridable via CLI)
MAX_POSITION_PCT=0.08         # Max 8% of portfolio per position
KELLY_FRACTION=0.5            # Half-Kelly
MIN_EDGE_PCT=0.03             # Minimum 3% edge to trade (lowered for more signals)
MIN_CONFIDENCE=0.70           # Minimum 70% confidence score (lowered for more signals)
LAG_THRESHOLD_PCT=0.03        # Kalshi must lag CEX by >3pp to flag

# Kill Switch
DAILY_DRAWDOWN_LIMIT=0.20     # Halt if daily drawdown > 20%

# Live Trading (all three must be "true" to enable live mode)
LIVE_TRADING_ENABLE=false
LIVE_TRADING_CONFIRM=false
LIVE_TRADING_OVERRIDE=false
